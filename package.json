{
  "name": "voicebridge",
  "version": "0.1.0-alpha.7",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "description": "Personal translated captions and speech for Discord voice rooms",
  "repository": {
    "type": "git",
    "url": "https://github.com/nexora-studio-tr/voicebridge.git"
  },
  "homepage": "https://github.com/nexora-studio-tr/voicebridge#readme",
  "bugs": {
    "url": "https://github.com/nexora-studio-tr/voicebridge/issues"
  },
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write src tests scripts *.json *.ts",
    "format:check": "prettier --check src tests scripts *.json *.ts",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "demo": "node --env-file-if-exists=.env.demo dist/server/main.js --demo",
    "setup": "node --env-file-if-exists=.env scripts/setup.mjs",
    "models": "node --env-file-if-exists=.env scripts/models.mjs",
    "test:browser": "node scripts/validate-browser.mjs",
    "test:local": "node --env-file-if-exists=.env scripts/validate-local.mjs",
    "test:worker": "node --env-file-if-exists=.env scripts/validate-worker.mjs",
    "quality": "node scripts/quality.mjs",
    "quality:queue": "node scripts/benchmark-quality-queue.mjs",
    "test:package": "node scripts/validate-package.mjs",
    "package:windows": "node scripts/package-windows.mjs",
    "test:launcher": "node scripts/validate-launcher.mjs",
    "test:windows": "node scripts/validate-windows.mjs"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.7",
    "discord.js": "14.27.0",
    "fastify": "5.12.7",
    "get-nonce": "1.0.1",
    "opusscript": "0.0.8",
    "prism-media": "1.3.5",
    "tar": "7.5.22",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lucide-react": "1.61.0",
    "prettier": "3.9.10",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "qs": "6.16.1"
  }
}
